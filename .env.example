# Claude writes brand profiles, hooks, captions and edits.
# Without a key Tadaa runs in demo mode with template text.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Where uploads, renders and the local database are stored (default: ./data).
# On a server, point this at a persistent volume.
# TADAA_DATA_DIR=/data

# Chrome/Chromium used to render MP4s (auto-detected on most Linux servers).
# REMOTION_BROWSER=/usr/bin/google-chrome

# Public URL the renderer uses to load uploaded media (defaults to the request origin).
# TADAA_RENDER_ORIGIN=http://localhost:3000

# Email (password resets). Without these, reset links are written to the server log instead.
# RESEND_API_KEY=
# TADAA_EMAIL_FROM=Tadaai <hello@tadaaai.com>

# Public address used in links in emails (defaults to the address the request came in on).
# TADAA_PUBLIC_URL=https://tadaaai.com

# Company details for the privacy policy and terms (shown as "registration in progress" until set)
# TADAA_COMPANY_NAME=Tadaai AB
# TADAA_COMPANY_ORGNR=559xxx-xxxx
# TADAA_COMPANY_ADDRESS=Street 1, 111 22 Stockholm
# TADAA_COMPANY_COUNTRY=Sweden
# TADAA_CONTACT_EMAIL=hello@tadaaai.com
